[{"no": "1", "a": "はるか昔にプレートの動きが終わり、侵食による平らな地形が多い。", "q": "安定陸塊について述べた文として正しいものを選びなさい。", "src": "スライド北欧p.3・スライドアフリカp.4", "sec": 0}, {"no": "2", "a": "アイスランド島・アトラス山脈", "q": "新期造山帯に位置するものの組合せとして正しいものを選びなさい。", "src": "スライド北欧p.6・スライドアフリカp.10", "sec": 0}, {"no": "3", "a": "夏に高温で乾燥し、冬に降水が多い。", "q": "地中海性気候の特徴として正しいものを選びなさい。", "src": "WS p.36・スライドアフリカp.20-21", "sec": 0}, {"no": "4", "a": "5", "q": "", "src": "スライド北欧p.2", "sec": 1}, {"no": "5", "a": "日光浴", "q": "", "src": "WS p.32", "sec": 1}, {"no": "6", "a": "北欧デザイン", "q": "", "src": "WS p.32・教p.147写真6", "sec": 1}, {"no": "7", "a": "ラップランド", "q": "", "src": "スライド北欧p.25・WS p.32", "sec": 1}, {"no": "8", "a": "共生", "q": "", "src": "WS p.32", "sec": 1}, {"no": "9", "a": "2", "q": "", "src": "スライド北欧p.26・WS p.33", "sec": 1}, {"no": "10", "a": "ヒュッゲ", "q": "", "src": "スライド北欧p.27・WS p.33", "sec": 1}, {"no": "11", "a": "抗菌", "q": "", "src": "スライド北欧p.28・WS p.33", "sec": 1}, {"no": "12", "a": "ユネスコ無形文化遺産", "q": "", "src": "スライド北欧p.31", "sec": 1}, {"no": "13", "a": "夏至祭", "q": "", "src": "スライド北欧p.32・p.34", "sec": 1}, {"no": "14", "a": "プロテスタント", "q": "", "src": "スライド北欧p.33・WS p.33", "sec": 1}, {"no": "15", "a": "イケア", "q": "", "src": "WS p.33", "sec": 1}, {"no": "16", "a": "フラットパック", "q": "", "src": "WS p.33", "sec": 1}, {"no": "17", "a": "鉄鉱石", "q": "", "src": "スライド北欧p.35・WS p.33", "sec": 1}, {"no": "18", "a": "クロム", "q": "", "src": "スライド北欧p.37・WS p.33", "sec": 1}, {"no": "19", "a": "リチウム", "q": "", "src": "スライド北欧p.37", "sec": 1}, {"no": "20", "a": "75", "q": "", "src": "スライド北欧p.38", "sec": 1}, {"no": "21", "a": "3", "q": "", "src": "スライド北欧p.38", "sec": 1}, {"no": "22", "a": "ストリーミング", "q": "", "src": "スライド北欧p.39", "sec": 1}, {"no": "23", "a": "水力", "q": "", "src": "スライド北欧p.40", "sec": 1}, {"no": "24", "a": "サーモン", "q": "", "src": "WS p.33", "sec": 1}, {"no": "25", "a": "トナカイの放牧や漁業、毛皮製品や手工芸品", "q": "この人々の主な収入源として最も適当なものを選びなさい。", "src": "スライド北欧p.25", "sec": 1}, {"no": "26", "a": "コーヒーを意味する「カッフィ」をひっくり返した造語", "q": "この名前の由来とされるものとして最も適当なものを選びなさい。", "src": "スライド北欧p.26", "sec": 1}, {"no": "あ", "a": "（例）韓国では夏の発汗や冬の保温のために辛いスパイスを使うが、北欧では保存食や、長い冬を家で楽しむためにお菓子などに使う。", "q": "この違いを説明しなさい。", "src": "スライド北欧p.29", "sec": 1}, {"no": "27", "a": "砂漠の暑さをしのぐ場として、西アジアから伝わった。", "q": "これについて述べた文として適当でないものを選びなさい。", "src": "スライド北欧p.31・WS p.33", "sec": 1}, {"no": "28", "a": "自国の港が凍るため、ノルウェーの不凍港まで運んで輸出している。", "q": "この鉱山の鉱石は、冬はどのように輸出されているか。最も適当なものを選びなさい。", "src": "スライド北欧p.35", "sec": 1}, {"no": "29", "a": "地盤沈下のため、街を丸ごと移転させる計画", "q": "近年、この鉱山の町で進められている国家プロジェクトを選びなさい。", "src": "スライド北欧p.36", "sec": 1}, {"no": "30", "a": "ボルボ", "q": "スウェーデンの代表的な自動車メーカーを選びなさい。", "src": "スライド北欧p.39・WS p.33", "sec": 1}, {"no": "い", "a": "（例）税が学費や医療費の無償化など国民へのサービスとして再分配され、生活の安心が国への信頼につながっているから。", "q": "北欧の国々は税が高いにもかかわらず幸福度が高い。その理由を「税」「生活の安心」の語を用いて説明しなさい。", "src": "スライド北欧p.41-42・WS p.33", "sec": 1}, {"no": "31", "a": "ノルウェー", "q": "地図Ⅰ中のBの国名を選びなさい。", "src": "課題B・WS p.31", "sec": 2}, {"no": "32", "a": "スウェーデン", "q": "地図Ⅰ中のCの国名を選びなさい。", "src": "課題B・WS p.31", "sec": 2}, {"no": "33", "a": "デンマーク", "q": "地図Ⅰ中のDの国名を選びなさい。", "src": "課題B・WS p.31", "sec": 2}, {"no": "34", "a": "オスロ", "q": "地図Ⅱ中のイの都市名を選びなさい。", "src": "課題B", "sec": 2}, {"no": "35", "a": "コペンハーゲン", "q": "地図Ⅱ中のエの都市名を選びなさい。", "src": "課題B", "sec": 2}, {"no": "36", "a": "オ", "q": "地図Ⅱ中のア〜オのうち、ヘルシンキの位置を選びなさい。", "src": "課題B", "sec": 2}, {"no": "37", "a": "オーストリア", "q": "2026年11月現在、NATOに加盟していない国を選びなさい。", "src": "課題B（NATO加盟国）", "sec": 2}, {"no": "38", "a": "AとB", "q": "地図Ⅰ中のA〜Eのうち、EUに加盟していない国の組合せを選びなさい。", "src": "教p.147図5", "sec": 2}, {"no": "39", "a": "ユトランド半島", "q": "地図Ⅰ中のDの国が北部を占める半島を選びなさい。", "src": "スライド北欧p.8・WS p.31", "sec": 2}, {"no": "40", "a": "沼地", "q": "地図Ⅰ中のEの国の自称「スオミ」の意味を選びなさい。", "src": "スライド北欧p.9", "sec": 2}, {"no": "41", "a": "アルプス山脈", "q": "地図Ⅲ中の③の山脈名を選びなさい。", "src": "2学期末ヨーロッパ地図 課題A・No.28課題A", "sec": 2}, {"no": "42", "a": "地中海", "q": "地図Ⅲ中の⑩の海名を選びなさい。", "src": "2学期末ヨーロッパ地図 課題A・No.28課題A", "sec": 2}, {"no": "43", "a": "ライン川", "q": "地図Ⅲ中の⑦の川名を選びなさい。", "src": "2学期末ヨーロッパ地図 課題A・No.28課題A", 