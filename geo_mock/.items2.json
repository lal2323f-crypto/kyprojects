[{"no": "1", "a": "コケ", "q": "ツンドラ気候（ET）の地域で、夏に地表に生えるものを選びなさい。", "src": "スライド北欧p.19・WS p.32", "sec": 0}, {"no": "2", "a": "はるか昔にプレートの動きが終わり、侵食による平らな地形が多い。", "q": "安定陸塊について述べた文として正しいものを選びなさい。", "src": "スライド北欧p.3・スライドアフリカp.4", "sec": 0}, {"no": "3", "a": "アイスランド島・アトラス山脈", "q": "新期造山帯に位置するものの組合せとして正しいものを選びなさい。", "src": "スライド北欧p.6・スライドアフリカp.10", "sec": 0}, {"no": "4", "a": "夏に高温で乾燥し、冬に降水が多い。", "q": "地中海性気候の特徴として正しいものを選びなさい。", "src": "WS p.36・スライドアフリカp.20-21", "sec": 0}, {"no": "5", "a": "サバンナは熱帯の丈の高い草原、ステップは乾燥帯の草原である。", "q": "サバンナとステップの違いについて述べた文として正しいものを選びなさい。", "src": "スライドアフリカp.18・p.20", "sec": 0}, {"no": "6", "a": "冬", "q": "アフリカの南回帰線付近の都市で、7月はどの季節にあたるか。", "src": "スライドアフリカp.21", "sec": 0}, {"no": "7", "a": "オーロラベルト", "q": "オーロラが高確率で現れる地域を何というか。", "src": "スライド北欧p.21", "sec": 0}, {"no": "8", "a": "冷帯が広く分布し、一部に温帯や寒帯が点在する。", "q": "北欧の気候の概要として正しいものを選びなさい。", "src": "スライド北欧p.13", "sec": 0}, {"no": "9", "a": "5", "q": "", "src": "スライド北欧p.2", "sec": 1}, {"no": "10", "a": "日光浴", "q": "", "src": "WS p.32", "sec": 1}, {"no": "11", "a": "北欧デザイン", "q": "", "src": "WS p.32・教p.147写真6", "sec": 1}, {"no": "12", "a": "ラップランド", "q": "", "src": "スライド北欧p.25・WS p.32", "sec": 1}, {"no": "13", "a": "共生", "q": "", "src": "WS p.32", "sec": 1}, {"no": "14", "a": "2", "q": "", "src": "スライド北欧p.26・WS p.33", "sec": 1}, {"no": "15", "a": "ヒュッゲ", "q": "", "src": "スライド北欧p.27・WS p.33", "sec": 1}, {"no": "16", "a": "抗菌", "q": "", "src": "スライド北欧p.28・WS p.33", "sec": 1}, {"no": "17", "a": "ユネスコ無形文化遺産", "q": "", "src": "スライド北欧p.31", "sec": 1}, {"no": "18", "a": "夏至祭", "q": "", "src": "スライド北欧p.32・p.34", "sec": 1}, {"no": "19", "a": "プロテスタント", "q": "", "src": "スライド北欧p.33・WS p.33", "sec": 1}, {"no": "20", "a": "イケア", "q": "", "src": "WS p.33", "sec": 1}, {"no": "21", "a": "フラットパック", "q": "", "src": "WS p.33", "sec": 1}, {"no": "22", "a": "鉄鉱石", "q": "", "src": "スライド北欧p.35・WS p.33", "sec": 1}, {"no": "23", "a": "クロム", "q": "", "src": "スライド北欧p.37・WS p.33", "sec": 1}, {"no": "24", "a": "リチウム", "q": "", "src": "