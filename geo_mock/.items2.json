[{"no": "1", "a": "楽しむ", "q": "", "src": "WS p.32", "sec": 0}, {"no": "2", "a": "ラップランド", "q": "", "src": "スライド北欧p.25・WS p.32", "sec": 0}, {"no": "3", "a": "8", "q": "", "src": "WS p.32", "sec": 0}, {"no": "4", "a": "トナカイ", "q": "", "src": "スライド北欧p.25・WS p.32", "sec": 0}, {"no": "5", "a": "プロテスタント", "q": "", "src": "スライド北欧p.33・WS p.33", "sec": 0}, {"no": "6", "a": "フィーカ", "q": "", "src": "スライド北欧p.26・WS p.33", "sec": 0}, {"no": "7", "a": "スパイス", "q": "", "src": "スライド北欧p.28-29・WS p.33", "sec": 0}, {"no": "8", "a": "リビング", "q": "", "src": "WS p.33", "sec": 0}, {"no": "9", "a": "毛皮製品や、木製のカップ「ククサ」などの手工芸品も収入源となっている。", "q": "下線部Aの人々の暮らしについて述べた文として最も適当なものを選びなさい。", "src": "スライド北欧p.25", "sec": 0}, {"no": "10", "a": "ヒュッゲ", "q": "下線部Bを何というか。", "src": "スライド北欧p.27・WS p.33", "sec": 0}, {"no": "11", "a": "砂漠の暑さをしのぐ場として、西アジアから伝わった。", "q": "下線部Cについて述べた文として適当でないものを選びなさい。", "src": "スライド北欧p.31", "sec": 0}, {"no": "12", "a": "ルクセンブルク", "q": "表1のXにあてはまる国を選びなさい。", "src": "スライド北欧p.30", "sec": 0}, {"no": "あ", "a": "夏至祭", "q": "スウェーデンやフィンランドで夏至のころに行われ、メイポールを広場に立てて短い夏の到来を祝う行事を何というか。", "src": "スライド北欧p.32・p.34", "sec": 0}, {"no": "13", "a": "天然", "q": "", "src": "WS p.33", "sec": 1}, {"no": "14", "a": "サーモン", "q": "", "src": "WS p.33", "sec": 1}, {"no": "15", "a": "鉄鉱石", "q": "", "src": "WS p.33・スライド北欧p.35", "sec": 1}, {"no": "16", "a": "不凍港", "q": "", "src": "スライド北欧p.35", "sec": 1}, {"no": "17", "a": "ボルボ", "q": "", "src": "WS p.33・スライド北欧p.39", "sec": 1}, {"no": "18", "a": "クロム", "q": "", "src": "WS p.33・スライド北欧p.37", "sec": 1}, {"no": "19", "a": "森林", "q": "", "src": "スライド北欧p.38", "sec": 1}, {"no": "20", "a": "油田", "q": "", "src": "WS p.33", "sec": 1}, {"no": "21", "a": "採掘による地盤沈下が深刻化し、街を丸ごと移転させる国家プロジェクトが進んでいる。", "q": "下線部Aがある町について、近年起きていることとして最も適当なものを選びなさい。", "src": "スライド北欧p.36", "sec": 1}, {"no": "22", "a": "水力発電", "q": "下線部Bの発電方法を選びなさい。", "src": "WS p.33", "sec": 1}, {"no": "23", "a": "世界第3位の木材輸出国で、製材の85％を輸出している。", "q": "スウェーデンの林業について述べた文として最も適当なものを選びなさい。", "src": "スライド北欧p.38", "sec": 1}, {"no": "24", "a": "家具を平らな箱に詰めて運ぶ「フラットパック」で、運ぶ費用を抑えた。", "q": "スウェーデン発祥の家具店が世界に広がった工夫として最も適当なものを選びなさい。", "src": "WS p.33", "sec": 1}, {"no": "25", "a": "高負担・高福祉", "q": "", "src": "WS p.33・スライド北欧p.41", "sec": 2}, {"no": "26", "a": "25", "q": "", "src": "WS p.33・スライド北欧p.41", "sec": 2}, {"no": "27", "a": "ウクライナ", "q": "", "src": "スライド北欧p.47", "sec": 2}, {"no": "28", "a": "中立", "q": "", "src": "スライド北欧p.44-45", "sec": 2}, {"no": "29", "a": "集団", "q": "", "src": "WS p.34", "sec": 2}, {"no": "30", "a": "安全保障", "q": "", "src": "WS p.34", "sec": 2}, {"no": "31", "a": "北大西洋条約機構", "q": "下線部Aの日本語の正式名称を選びなさい。", "src": "WS p.34・スライド北欧p.46", "sec": 2}, {"no": "32", "a": "日本も正式な加盟国として参加している。", "q": "下線部Aについて述べた文として適当でないものを選びなさい。", "src": "WS p.34", "sec": 2}, {"no": "33", "a": "オスロ", "q": "地図中のイの都市名を選びなさい。", "src": "2学期末ヨーロッパ地図 課題B", "sec": 2}, {"no": "34", "a": "オ", "q": "地図中のア〜オのうち、ヘルシンキの位置を選びなさい。", "src": "2学期末ヨーロッパ地図 課題B", "sec": 2}, {"no": "35", "a": "半島北部と周辺の島々からなり、最も高い地点でも約172mの平坦な国である。", "q": "地図中のエの都市が首都である国について述べた文として最も適当なものを選びなさい。", "src": "スライド北欧p.8", "sec": 2}, {"no": "い", "a": "レイキャビク", "q": "地図中のアの都市名を答えなさい。", "src": "2学期末ヨーロッパ地図 課題B", "sec": 2}, {"no": "う", "a": "（例）税が教育費や医療費の無償化など国民へのサービスとして再分配され、生活の安心が国への信頼につながっているから。", "q": "北欧の国々は税金が高いにもかかわらず、国民の幸福度が高い。その理由を、「税」「生活の安心」の二つの語を用いて説明しなさい。", "src": "スライド北欧p.41-42・WS p.33", "sec": 2}, {"no": "36", "a": "3000", "q": "", "src": "スライドアフリカp.22・WS p.36", "sec": 3}, {"no": "37", "a": "ズールー族", "q": "", "src": "スライドアフリカp.22・WS p.36", "sec": 3}, {"no": "38", "a": "ベルベル人", "q": "", "src": "スライドアフリカp.22・WS p.36", "sec": 3}, {"no": "39", "a": "植民地", "q": "", "src": "WS p.36・教p.140", "sec": 3}, {"no": "40", "a": "経線や緯線", "q": "", "src": "WS p.36・スライドアフリカp.39", "sec": 3}, {"no": "41", "a": "44", "q": "", "src": "スライドアフリカp.39", "sec": 3}, {"no": "42", "a": "フランス語", "q": "", "src": "WS p.36・教p.140", "sec": 3}, {"no": "43", "a": "アラビア語", "q": "", "src": "スライドアフリカp.23・WS p.36", "sec": 3}, {"no": "44", "a": "キリスト教", "q": "", "src": "スライドアフリカp.25・WS p.36", "sec": 3}, {"no": "45", "a": "アニミズム", "q": "", "src": "スライドアフリカp.26・WS p.36", "sec": 3}, {"no": "46", "a": "男性は色鮮やかな一枚布のブランケットを巻き衣として身にまとう。", "q": "下線部Aの人々の衣装について述べた文として最も適当なものを選びなさい。", "src": "教p.139写真9", "sec": 3}, {"no": "47", "a": "もともと不仲な複数の民族が、無理やり一つの国の中に閉じ込められた。", "q": "下線部Bのうち、「異民族の強制同居」の説明として最も適当なものを選びなさい。", "src": "WS p.36", "sec": 3}, {"no": "48", "a": "心配ないさ", "q": "下線部Cについて、映画『ライオン・キング』で登場したスワヒリ語「ハクナ・マタタ」の意味を選びなさい。", "src": "スライドアフリカp.23", "sec": 3}, {"no": "49", "a": "サプール", "q": "コンゴから始まり、少ない収入でも思い切りおしゃれをして町を歩き、平和を訴える人々を何というか。", "src": "スライドアフリカp.24・教p.143", "sec": 3}, {"no": "50", "a": "バナナ", "q": "", "src": "教p.141", "sec": 4}, {"no": "51", "a": "焼畑", "q": "", "src": "スライドアフリカp.27・WS p.36", "sec": 4}, {"no": "52", "a": "とうもろこし", "q": "", "src": "教p.141・WS p.36", "sec": 4}, {"no": "53", "a": "インジェラ", "q": "", "src": "教p.141", "sec": 4}, {"no": "54", "a": "カカオ", "q": "", "src": "スライドアフリカp.28・WS p.37", "sec": 4}, {"no": "55", "a": "ワイン", "q": "", "src": "スライドアフリカp.32・WS p.37", "sec": 4}, {"no": "56", "a": "ナイジェリア", "q": "表2中のXにあてはまる国を選びなさい。", "src": "スライドアフリカp.29の表", "sec": 4}, {"no": "57", "a": "エチオピア", "q": "表3中のYにあてはまる国を選びなさい。", "src": "スライドアフリカp.28-30の表", "sec": 4}, {"no": "58", "a": "ケニア", "q": "表4中のZにあてはまる国を選びなさい。", "src": "スライドアフリカp.28・p.30の表", "sec": 4}, {"no": "59", "a": "マトケ", "q": "下線部Aの料理を選びなさい。", "src": "教p.141写真3", "sec": 4}, {"no": "60", "a": "表2の上位5か国のうち、3か国がアフリカの国である。", "q": "表2〜表4から読み取れることとして最も適当なものを選びなさい。", "src": "スライドアフリカp.29-30の表", "sec": 4}, {"no": "え", "a": "商品作物", "q": "アフリカで、自分たちで食べるためではなく、主に輸出して売るために栽培されてきた作物を何というか（漢字4字）。", "src": "教p.141", "sec": 4}, {"no": "61", "a": "ケスタ", "q": "", "src": "教p.148", "sec": 5}, {"no": "62", "a": "西岸海洋性気候", "q": "", "src": "教p.148", "sec": 5}, {"no": "63", "a": "アルプス山脈", "q": "", "src": "教p.149", "sec": 5}, {"no": "64", "a": "園芸農業", "q": "", "src": "教p.149", "sec": 5}, {"no": "65", "a": "灌漑施設の整備によって、果樹や野菜の栽培が中心になっている。", "q": "下線部Aの地域の近年の農業について述べた文として最も適当なものを選びなさい。", "src": "教p.149", "sec": 5}, {"no": "66", "a": "レンガ", "q": "下線部Bを選びなさい。", "src": "教p.149写真6", "sec": 5}, {"no": "お", "a": "木骨建築", "q": "ドイツやイギリスに多い、木材で骨組みをつくり、その間を石などで埋めて外壁を組み上げる建築方式を何というか。", "src": "教p.149写真8", "sec": 5}]