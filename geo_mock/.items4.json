[{"no": "1", "a": "5", "q": "", "src": "スライド北欧p.2", "sec": 0}, {"no": "2", "a": "北海道", "q": "", "src": "スライド北欧p.16", "sec": 0}, {"no": "3", "a": "4か月以上", "q": "", "src": "スライド北欧p.14・p.16", "sec": 0}, {"no": "4", "a": "偏西風", "q": "", "src": "スライド北欧p.15", "sec": 0}, {"no": "5", "a": "6〜8", "q": "", "src": "スライド北欧p.12", "sec": 0}, {"no": "6", "a": "100", "q": "", "src": "スライド北欧p.12", "sec": 0}, {"no": "7", "a": "風力", "q": "", "src": "スライド北欧p.40", "sec": 0}, {"no": "8", "a": "寒冷で夏が短く、野菜を育てられる期間が限られるから。", "q": "下線部Aの理由として最も適当なものを選びなさい。", "src": "スライド北欧p.12・p.17", "sec": 0}, {"no": "9", "a": "ストックホルム", "q": "地図中のウの都市名を選びなさい。", "src": "2学期末ヨーロッパ地図 課題B", "sec": 0}, {"no": "10", "a": "ア", "q": "地図中のア〜オのうち、国土の大半が火山島で、プレートの裂け目が地上で見られる国の首都を選びなさい。", "src": "スライド北欧p.6・課題B", "sec": 0}, {"no": "11", "a": "Dfcの地域は、気温10℃以上の月が半年以上あり、夏が長い。", "q": "北欧の気候について述べた文として適当でないものを選びなさい。", "src": "スライド北欧p.14-20・WS p.32", "sec": 0}, {"no": "12", "a": "カルダモン", "q": "", "src": "スライド北欧p.28-29・WS p.33", "sec": 1}, {"no": "13", "a": "コーヒー", "q": "", "src": "スライド北欧p.28", "sec": 1}, {"no": "14", "a": "抗菌", "q": "", "src": "スライド北欧p.28", "sec": 1}, {"no": "15", "a": "75", "q": "", "src": "スライド北欧p.38", "sec": 1}, {"no": "16", "a": "パルプ", "q": "", "src": "スライド北欧p.38", "sec": 1}, {"no": "17", "a": "リチウム", "q": "", "src": "スライド北欧p.37", "sec": 1}, {"no": "18", "a": "ストリーミング", "q": "", "src": "スライド北欧p.39", "sec": 1}, {"no": "19", "a": "シナモンロール", "q": "北欧でよく食べられているスパイス入りのお菓子として最も適当なものを選びなさい。", "src": "スライド北欧p.28", "sec": 1}, {"no": "20", "a": "ボルボ", "q": "スウェーデンの代表的な高級車メーカーを選びなさい。", "src": "WS p.33・スライド北欧p.39", "sec": 1}, {"no": "21", "a": "北海で産出した石油や天然ガスをヨーロッパへ売り、国内の電気はほぼ水力発電でまかなっている。", "q": "ノルウェーのエネルギーについて述べた文として最も適当なものを選びなさい。", "src": "WS p.33", "sec": 1}, {"no": "22", "a": "クロム", "q": "フィンランドで、EU内で唯一産出され、ステンレスに欠かせない金属を選びなさい。", "src": "WS p.33・スライド北欧p.37", "sec": 1}, {"no": "あ", "a": "（例）韓国では夏の発汗や冬の保温のために辛いスパイスを使うが、北欧では保存食や、長い冬を家で楽しむためにお菓子などにスパイスを使う。", "q": "下線部Aについて、北欧のスパイスの使われ方を、韓国と比較して説明しなさい。", "src": "スライド北欧p.29", "sec": 1}, {"no": "23", "a": "氷河湖", "q": "", "src": "教p.148", "sec": 2}, {"no": "24", "a": "ポルダー", "q": "", "src": "教p.148写真1", "sec": 2}, {"no": "25", "a": "亜寒帯湿潤気候", "q": "", "src": "教p.148", "sec": 2}, {"no": "26", "a": "地中海性気候", "q": "", "src": "教p.148", "sec": 2}, {"no": "27", "a": "ライ麦", "q": "", "src": "教p.149", "sec": 2}, {"no": "28", "a": "北上", "q": "", "src": "教p.149", "sec": 2}, {"no": "29", "a": "石造り", "q": "", "src": "教p.149写真7", "sec": 2}, {"no": "30", "a": "ワイン", "q": "下線部Aを選びなさい。", "src": "教p.149", "sec": 2}, {"no": "31", "a": "小麦 北緯60度・ぶどう 北緯50度", "q": "教科書p.149図5の小麦とぶどうの栽培限界が、ヨーロッパ西部でおよそ通る緯度の組合せとして最も適当なものを選びなさい。", "src": "教p.149図5・No.28課題B", "sec": 2}, {"no": "32", "a": "混合農業・酪農", "q": "ヨーロッパの伝統的な農業はアルプス山脈を境に南北に分けられる。北側の農業を選びなさい。", "src": "教p.149", "sec": 2}, {"no": "33", "a": "EC（ヨーロッパ共同体）", "q": "教科書p.147によると、1967年に西ドイツ・フランス・イタリア・ベネルクス3国の6か国で成立した組織を選びなさい。", "src": "教p.147図5", "sec": 2}, {"no": "い", "a": "ケスタ", "q": "パリ盆地などにみられる、なだらかな斜面と急な斜面が交互に続く地形を何というか。", "src": "教p.148写真2", "sec": 2}, {"no": "34", "a": "Af", "q": "", "src": "WS p.35", "sec": 3}, {"no": "35", "a": "砂漠気候", "q": "", "src": "WS p.35", "sec": 3}, {"no": "36", "a": "標高", "q": "", "src": "教p.139図6", "sec": 3}, {"no": "37", "a": "米", "q": "", "src": "教p.141写真6", "sec": 3}, {"no": "38", "a": "フランスパン", "q": "", "src": "教p.141写真7", "sec": 3}, {"no": "39", "a": "雨季", "q": "", "src": "教p.140", "sec": 3}, {"no": "40", "a": "コシャリ", "q": "下線部Aの料理を選びなさい。", "src": "教p.141写真8", "sec": 3}, {"no": "41", "a": "エ", "q": "図1のア〜エのうち、赤道直下の都市の雨温図として最も適当なものを選びなさい。", "src": "スライドアフリカp.15", "sec": 3}, {"no": "42", "a": "丈の高い草原と、乾燥に強い高木がまばらに生える疎林", "q": "図2中のBの気候の植生として最も適当なものを選びなさい。", "src": "スライドアフリカp.18", "sec": 3}, {"no": "43", "a": "夏", "q": "アフリカのサバナ気候の地域で、雨が多く降る季節を選びなさい。", "src": "スライドアフリカp.17", "sec": 3}, {"no": "う", "a": "スコール", "q": "熱帯雨林気候の地域で、1日の気温変化が大きく、午後に降る激しい雨を何というか。", "src": "スライドアフリカp.15", "sec": 3}, {"no": "44", "a": "ムスリム", "q": "", "src": "教p.140", "sec": 4}, {"no": "45", "a": "奴隷貿易", "q": "", "src": "教p.140", "sec": 4}, {"no": "46", "a": "サブサハラ", "q": "", "src": "教p.140注②", "sec": 4}, {"no": "47", "a": "公用語", "q": "", "src": "教p.140", "sec": 4}, {"no": "48", "a": "コプト教", "q": "", "src": "教p.139写真8", "sec": 4}, {"no": "49", "a": "ヨウジ・ヤマモト", "q": "", "src": "教p.143", "sec": 4}, {"no": "50", "a": "131", "q": "", "src": "スライドアフリカp.22", "sec": 4}, {"no": "51", "a": "トゥアレグ人", "q": "下線部Aの民族を選びなさい。", "src": "教p.139写真5", "sec": 4}, {"no": "52", "a": "アフロ=アジア語族", "q": "教科書p.140図2で、北アフリカで多く話され、アラビア語とその方言が大半を占める語族を選びなさい。", "src": "教p.140図2", "sec": 4}, {"no": "53", "a": "イスラーム（スンナ派）", "q": "アフリカのサハラ以北で多数を占める宗教とその宗派を選びなさい。", "src": "スライドアフリカp.25", "sec": 4}, {"no": "54", "a": "東アフリカ", "q": "スワヒリ語が広く使われている地域を選びなさい。", "src": "スライドアフリカp.23・WS p.36", "sec": 4}, {"no": "55", "a": "原油", "q": "", "src": "教p.141", "sec": 5}, {"no": "56", "a": "レアメタル", "q": "", "src": "教p.141", "sec": 5}, {"no": "57", "a": "セレンゲティ", "q": "", "src": "教p.143写真7", "sec": 5}, {"no": "58", "a": "エコツーリズム", "q": "", "src": "教p.143写真7", "sec": 5}, {"no": "59", "a": "ナイジェリア", "q": "", "src": "教p.142豆知識", "sec": 5}, {"no": "60", "a": "薪", "q": "", "src": "教p.143", "sec": 5}, {"no": "61", "a": "コンゴ民主共和国", "q": "表1中のXにあてはまる国を選びなさい。", "src": "スライドアフリカp.33の表", "sec": 5}, {"no": "62", "a": "ザンビア", "q": "表1中のYにあてはまる国を選びなさい。", "src": "スライドアフリカp.33の表", "sec": 5}, {"no": "63", "a": "ガーナ", "q": "表2中のZにあてはまる国を選びなさい。", "src": "スライドアフリカp.33の表", "sec": 5}, {"no": "64", "a": "一次産品を輸出するだけでなく、国内で加工・販売まで行う産業を育てる。", "q": "下線部Aの例として最も適当なものを選びなさい。", "src": "WS p.37・教p.141", "sec": 5}, {"no": "65", "a": "表2の上位10か国に入っているアフリカの国は2か国である。", "q": "表1・表2から読み取れることとして最も適当なものを選びなさい。", "src": "スライドアフリカp.33の表", "sec": 5}, {"no": "え", "a": "フェアトレード", "q": "適正な価格で取引することで、生産者の生活を支える取り組みを何というか（カタカナ）。", "src": "WS p.37・教p.141", "sec": 5}, {"no": "お", "a": "不等価交換", "q": "モノカルチャー経済が抱える罠のうち、安い原料を輸出して高い製品を輸入するため、利益が残らないことを何というか。", "src": "WS p.37", "sec": 5}]