[{"no": "1", "a": "最寒月の平均気温が-3℃未満になる。", "q": "冷帯（D）の気候の特徴として正しいものを選びなさい。", "src": "スライド北欧p.14・WS p.32", "sec": 0}, {"no": "2", "a": "コケ", "q": "ツンドラ気候（ET）の地域で、夏に地表に生えるものを選びなさい。", "src": "スライド北欧p.19・WS p.32", "sec": 0}, {"no": "3", "a": "冬", "q": "アフリカの南回帰線付近の都市で、7月はどの季節にあたるか。", "src": "スライドアフリカp.21", "sec": 0}, {"no": "4", "a": "夏季に極端に夜が短くなる現象", "q": "白夜の説明として正しいものを選びなさい。", "src": "スライド北欧p.23・WS p.32", "sec": 0}, {"no": "5", "a": "6", "q": "標高が1000m上がると、気温はおよそ何℃下がるか。", "src": "WS p.35", "sec": 0}, {"no": "6", "a": "盾を伏せたような、緩やかな台地状の地形", "q": "楯状地の説明として正しいものを選びなさい。", "src": "WS p.31・スライド北欧p.3", "sec": 0}, {"no": "7", "a": "オーロラベルト", "q": "オーロラが高確率で現れる地域を何というか。", "src": "スライド北欧p.21", "sec": 0}, {"no": "8", "a": "北極圏", "q": "", "src": "スライド北欧p.21・WS p.31", "sec": 1}, {"no": "9", "a": "バルト楯状地", "q": "", "src": "スライド北欧p.3・WS p.31", "sec": 1}, {"no": "10", "a": "古期造山帯", "q": "", "src": "スライド北欧p.4・WS p.31", "sec": 1}, {"no": "11", "a": "なだらか", "q": "", "src": "WS p.31・スライド北欧p.4-5", "sec": 1}, {"no": "12", "a": "ユーラシアプレート", "q": "", "src": "スライド北欧p.6-7・WS p.31", "sec": 1}, {"no": "13", "a": "火山・温泉", "q": "", "src": "WS p.31・スライド北欧p.6", "sec": 1}, {"no": "14", "a": "ユトランド半島", "q": "", "src": "スライド北欧p.8・WS p.31", "sec": 1}, {"no": "15", "a": "氷河", "q": "", "src": "スライド北欧p.9・WS p.31", "sec": 1}, {"no": "16", "a": "森と湖", "q": "", "src": "スライド北欧p.9・WS p.31", "sec": 1}, {"no": "17", "a": "やせ", "q": "", "src": "WS p.31", "sec": 1}, {"no": "18", "a": "北大西洋海流", "q": "", "src": "スライド北欧p.14-16・WS p.32", "sec": 1}, {"no": "19", "a": "4か月以上", "q": "", "src": "スライド北欧p.14・WS p.32", "sec": 1}, {"no": "20", "a": "3か月", "q": "", "src": "スライド北欧p.17・WS p.32", "sec": 1}, {"no": "21", "a": "パルプ", "q": "", "src": "WS p.32・スライド北欧p.18", "sec": 1}, {"no": "22", "a": "永久凍土", "q": "", "src": "スライド北欧p.20・WS p.32", "sec": 1}, {"no": "23", "a": "トナカイ", "q": "", "src": "スライド北欧p.20・WS p.32", "sec": 1}, {"no": "24", "a": "キルナ鉱山", "q": "この鉄鉱石を産出する、世界最大の地下鉄鉱山を選びなさい。", "src": "スライド北欧p.4・p.35", "sec": 1}, {"no": "25", "a": "ギャオ", "q": "この地上で見られるプレートの裂け目を何というか。", "src": "スライド北欧p.6・WS p.31", "sec": 1}, {"no": "26", "a": "フィヨルド", "q": "この地形を何というか。", "src": "スライド北欧p.9・WS p.31", "sec": 1}, {"no": "27", "a": "偏西風", "q": "この気候の地域に暖気を運ぶ風を選びなさい。", "src": "スライド北欧p.14・WS p.32", "sec": 1}, {"no": "28", "a": "タイガ", "q": "この針葉樹林を何というか。", "src": "スライド北欧p.18・WS p.32", "sec": 1}, {"no": "29", "a": "寒いので腐葉土ができないから。", "q": "この地域で農業が不向きな理由として最も適当なものを選びなさい。", "src": "スライド北欧p.18", "sec": 1}, {"no": "30", "a": "サーミ", "q": "写真は、スカンジナビア北部の先住民の暮らしである。この先住民を何というか。", "src": "スライド北欧p.22・p.25", "sec": 1}, {"no": "あ", "a": "麦類（麦も可）", "q": "スウェーデンやフィンランドの南部で、ジャガイモとともに生産されている作物を答えなさい。", "src": "スライド北欧p.12・WS p.31", "sec": 1}, {"no": "い", "a": "パートナー（パートナー国も可）", "q": "NATOに加盟していないが、NATOと協力関係をもつ日本の立場をカタカナで答えなさい。", "src": "WS p.34", "sec": 1}, {"no": "31", "a": "アイスランド", "q": "地図Ⅰ中のAの国名を選びなさい。", "src": "2学期末ヨーロッパ地図 課題B・WS p.31", "sec": 2}, {"no": "32", "a": "B ノルウェー・C スウェーデン", "q": "地図Ⅰ中のB・Cの国名の組合せとして正しいものを選びなさい。", "src": "課題B・WS p.31", "sec": 2}, {"no": "33", "a": "D デンマーク・E フィンランド", "q": "地図Ⅰ中のD・Eの国名の組合せとして正しいものを選びなさい。", "src": "課題B・WS p.31", "sec": 2}, {"no": "34", "a": "レイキャビク", "q": "地図Ⅱ中のアの都市名を選びなさい。", "src": "課題B", "sec": 2}, {"no": "35", "a": "ストックホルム", "q": "地図Ⅱ中のウの都市名を選びなさい。", "src": "課題B", "sec": 2}, {"no": "36", "a": "ヘルシンキ", "q": "地図Ⅱ中のオの都市名を選びなさい。", "src": "課題B", "sec": 2}, {"no": "37", "a": "スイス", "q": "2026年11月現在、NATOに加盟していない国を選びなさい。", "src": "課題B（NATO加盟国）", "sec": 2}, {"no": "38", "a": "E", "q": "地図Ⅰ中のA〜Eのうち、2023年にNATOに加盟した国を選びなさい。", "src": "WS p.34・スライド北欧p.44", "sec": 2}, {"no": "39", "a": "C", "q": "地図Ⅰ中のA〜Eのうち、2024年にNATOに加盟した国を選びなさい。", "src": "WS p.34・スライド北欧p.45", "sec": 2}, {"no": "40", "a": "32", "q": "2026年11月現在のNATOの加盟国数を選びなさい。", "src": "WS p.34・課題B", "sec": 2}, {"no": "41", "a": "プレートの境界に位置し、火山や温泉が多い。", "q": "地図Ⅰ中のAの国の地形について述べた文として最も適当なものを選びなさい。", "src": "スライド北欧p.6・WS p.31", "sec": 2}, {"no": "42", "a": "フィンランド", "q": "地図Ⅰ中のEの国名を選びなさい。", "src": "課題B・WS p.31", "sec": 2}, {"no": "43",